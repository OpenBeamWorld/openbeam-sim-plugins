<!--
  SPDX-License-Identifier: GPL-3.0-or-later
  Coil memory in MuJoCo: two identical OpenBeam Cat6 cables on a desk.

  "wound" is wound once round a 120 mm spool, held, and let go: its first
  cross-section is held on the spool, released over 0.05 s, and the spool then
  sinks below the desk. The spool is a mocap body, a motor-driven winder that
  coil_demo.py turns and lowers on a set profile: a cable this light does not
  slow a winder's motor, and a free MuJoCo body this light and this stiffly
  coupled would need a smaller MuJoCo step than 2 ms. Jacket
  friction is 0.5 static and 0.4 sliding (PVC on laminate). "fresh"
  is never touched. Both are assets/cat6_coil.jbeam with the same .materials:
  copper conductors that yield past a 150 mm bend radius, an elastic jacket.
  Run it with mujoco/coil_demo.py.
-->
<mujoco model="openbeam_cable_coil">
  <option timestep="0.002" integrator="implicitfast"/>

  <extension>
    <plugin plugin="openbeam.softbody">
      <instance name="wound">
        <config key="jbeam" value="cat6_coil.jbeam"/>
        <config key="materials" value="cat6_coil.materials"/>
        <config key="pos" value="-0.4 0.12 0.0"/>
        <config key="step" value="0.000033"/>
        <config key="node_radius" value="0.00118"/>
        <config key="node_damping" value="6"/>
        <config key="release" value="0.05"/>
        <config key="colliders" value="spool"/>
        <config key="attach" value="s0_*:spool"/>
        <config key="friction" value="0.5 0.4"/>
        <config key="stress_scale" value="30"/>
        <config key="strain_scale" value="0.02"/>
        <config key="beam_width" value="0.0012"/>
      </instance>
      <instance name="fresh">
        <config key="jbeam" value="cat6_coil.jbeam"/>
        <config key="materials" value="cat6_coil.materials"/>
        <config key="pos" value="-0.4 -0.12 0.0"/>
        <config key="friction" value="0.5 0.4"/>
        <config key="step" value="0.000033"/>
        <config key="node_radius" value="0.00118"/>
        <config key="node_damping" value="6"/>
        <config key="stress_scale" value="30"/>
        <config key="strain_scale" value="0.02"/>
        <config key="beam_width" value="0.0012"/>
      </instance>
    </plugin>
  </extension>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient=".35 .35 .35" diffuse=".5 .5 .5"/>
  </visual>
  <statistic center="0 0 0.02" extent="0.6"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".72 .78 .86" rgb2=".2 .24 .3" width="256" height="256"/>
    <texture name="desk" type="2d" builtin="checker" rgb1=".62 .63 .66" rgb2=".56 .57 .6" width="512" height="512"/>
    <material name="desk" texture="desk" texrepeat="12 12" reflectance=".08"/>
    <material name="spool" rgba=".55 .4 .25 1"/>
  </asset>

  <worldbody>
    <light pos="0.2 -0.6 1.4" dir="-0.1 0.4 -1" directional="true" castshadow="true"/>
    <geom name="desk" type="plane" size="1.5 1.5 0.05" material="desk"/>

    <!-- The spool: its surface touches the wound cable's first section from +y. coil_demo.py turns it
         about z and lowers it below the desk. -->
    <body name="spool" mocap="true" pos="-0.4 0.183 0.01">
      <geom name="spool" type="capsule" size="0.06 0.02" material="spool" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="0 0 0.07" size="0.07 0.004" material="spool" contype="0" conaffinity="0"/>
    </body>

    <camera name="overview" pos="0.25 -0.75 0.75" xyaxes="0.951 0.309 0 -0.210 0.646 0.734" fovy="45"/>
  </worldbody>

  <sensor>
    <plugin name="wound_state" instance="wound"/>
    <plugin name="fresh_state" instance="fresh"/>
  </sensor>
</mujoco>
